# Copy to .env on the server (chmod 600) and fill in real values. Never commit .env.
WHISPER_API_URL=http://<gateway-host>:<port>/v1
WHISPER_API_KEY=<api-key>
WHISPER_API_MODEL=whisper
WHISPER_API_LANGUAGE=tr

TRANSCRIPT_STATUS_API_URL=https://<pharmaveritas-host>/eye
TRANSCRIPT_STATUS_API_KEY=<transcript-status-api-key>

SKYNET_S3_ENDPOINT=https://<storage-host>
SKYNET_S3_BUCKET=eye-transcripts
SKYNET_S3_ACCESS_KEY=<access-key>
SKYNET_S3_SECRET_KEY=<secret-key>
